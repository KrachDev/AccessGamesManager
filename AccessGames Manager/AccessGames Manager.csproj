<Project Sdk="Microsoft.NET.Sdk">
  <PropertyGroup>
    <OutputType>WinExe</OutputType>
    <TargetFramework>net9.0-windows</TargetFramework>
    <Nullable>enable</Nullable>
    <ApplicationManifest>app.manifest</ApplicationManifest>
    <AvaloniaUseCompiledBindingsByDefault>true</AvaloniaUseCompiledBindingsByDefault>
    <Version>1.0.0</Version>
    <AssemblyVersion>1.0.0.0</AssemblyVersion>
    <FileVersion>1.0.0.0</FileVersion>
    <AssemblyName>AccessGames Manager</AssemblyName>
    <RootNamespace>AccessGames_Manager</RootNamespace>
    <Product>AccessGames Manager</Product>
    <Company>KrachDev Company</Company>
    <Authors>KrachDev</Authors>
    <Copyright>© 2024 KrachDev Company. All rights reserved.</Copyright>
    <Description>Modern Windows desktop application for managing and organizing game libraries with Steam integration, account management, and firewall control.</Description>
    <PackageProjectUrl>https://github.com/KrachDev/AccessGamesManager</PackageProjectUrl>
    <RepositoryUrl>https://github.com/KrachDev/AccessGamesManager</RepositoryUrl>
    <RepositoryType>git</RepositoryType>
    <InformationalVersion>1.0.0</InformationalVersion>

    <!-- ═══════════════════════════════════════════════════ -->
    <!-- SLIM BUILD OPTIMIZATION - TARGET 30MB MAX         -->
    <!-- ═══════════════════════════════════════════════════ -->

    <!-- Single-file publish defaults -->
    <SelfContained>true</SelfContained>
    <PublishSingleFile>true</PublishSingleFile>
    <IncludeNativeLibrariesForSelfExtract>true</IncludeNativeLibrariesForSelfExtract>
    <EnableCompressionInSingleFile>true</EnableCompressionInSingleFile>

    <!-- Aggressive trimming for size reduction -->
    <PublishTrimmed>true</PublishTrimmed>
    <TrimMode>partial</TrimMode>
    <EnableAotAnalyzer>false</EnableAotAnalyzer>
    <InvariantGlobalization>false</InvariantGlobalization>
    <MetadataLevelInSingleFile>full</MetadataLevelInSingleFile>

    <!-- Compile ahead of time for smaller size AND faster startup -->
    <PublishReadyToRun>true</PublishReadyToRun>
    <PublishReadyToRunComposite>true</PublishReadyToRunComposite>

    <!-- Strip everything non-essential -->
    <DebugType>none</DebugType>
    <DebugSymbols>false</DebugSymbols>
    <Deterministic>true</Deterministic>
    <CopyLocalLockFileAssemblies>false</CopyLocalLockFileAssemblies>
    <IncludeSymbolsInSingleFile>false</IncludeSymbolsInSingleFile>
    <DisableImplicitFrameworkReferences>false</DisableImplicitFrameworkReferences>
    <UseRuntimeIdentifierInPath>false</UseRuntimeIdentifierInPath>

    <!-- Platform-specific optimizations -->
    <RuntimeIdentifier>win-x64</RuntimeIdentifier>
    <SelfContainedRollForward>LatestPatch</SelfContainedRollForward>
  </PropertyGroup>

  <ItemGroup>
    <Folder Include="Models\" />
    <AvaloniaResource Include="Assets\**" />
    <!-- Copy Assets folder to output directory (excluding store.html) -->
    <None Include="Assets\**" CopyToOutputDirectory="PreserveNewest" Link="Assets\%(Filename)%(Extension)" />
    <!-- Trimmer root descriptor for safe trimming -->
    <TrimmerRootAssembly Include="AccessGames Manager" />
  </ItemGroup>

  <ItemGroup>
    <PackageReference Include="Avalonia" Version="11.3.10" />
    <PackageReference Include="Avalonia.Desktop" Version="11.3.10" />
    <PackageReference Include="Avalonia.Themes.Fluent" Version="11.3.10" />
    <PackageReference Include="Avalonia.Fonts.Inter" Version="11.3.10" />
    <!--Condition below is needed to remove Avalonia.Diagnostics package from build output in Release configuration.-->
    <PackageReference Include="Avalonia.Diagnostics" Version="11.3.10">
      <IncludeAssets Condition="'$(Configuration)' != 'Debug'">None</IncludeAssets>
      <PrivateAssets Condition="'$(Configuration)' != 'Debug'">All</PrivateAssets>
    </PackageReference>
    <PackageReference Include="CommunityToolkit.Mvvm" Version="8.2.1" />
    <PackageReference Include="Gameloop.Vdf" Version="0.6.2" />
    <PackageReference Include="Gameloop.Vdf.JsonConverter" Version="0.2.1" />
    <PackageReference Include="InputSimulator" Version="1.0.4" />
    <PackageReference Include="MessageBox.Avalonia" Version="3.3.1.1" />
    <PackageReference Include="Microsoft.Extensions.Logging.Abstractions" Version="8.0.2" />
    <PackageReference Include="Newtonsoft.Json" Version="13.0.3" />
    <PackageReference Include="Orlys.Nautilus" Version="2.0.2" />
    <PackageReference Include="SteamKit2" Version="2.5.0" />
    <PackageReference Include="vocaluxe.dependencies.netfwtypelib" Version="1.0.1" />
    <!-- REMOVED: WebView packages for slim build - no store/web functionality -->
    <!-- PackageReference Include="WebView.Avalonia" Version="11.0.0.1" / -->
    <!-- PackageReference Include="WebView.Avalonia.Desktop" Version="11.0.0.1" / -->
  </ItemGroup>
</Project>
